{
  "id": "herdr",
  "name": "Herdr",
  "version": "1.0.0",
  "description": "Report GSD lifecycle state and auto-mode context to a Herdr pane",
  "tier": "bundled",
  "requires": { "platform": ">=2.29.0" },
  "provides": {
    "hooks": [
      "session_start",
      "session_shutdown",
      "session_end",
      "agent_start",
      "turn_start",
      "turn_end",
      "stop",
      "notification"
    ]
  }
}
